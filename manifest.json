{
  "manifest_version": 3,
  "name": "GitHub PR HTML Preview",
  "version": "1.0.1",
  "description": "Preview HTML files directly from GitHub PR changes",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "src/preview/preview.html"
  },
  "host_permissions": [
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GitHub PR Preview Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "theme_icons": [
      {
        "light": "icons/icon16-light.png",
        "dark": "icons/icon16-dark.png",
        "size": 16
      },
      {
        "light": "icons/icon48-light.png",
        "dark": "icons/icon48-dark.png",
        "size": 48
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/preview/preview.html", "icons/*"],
      "matches": ["https://github.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
